# Config for pipeline.manuscript.yaml — where results/figures live and where they
# get exported to. Copy to env.manuscript.yaml and edit the paths for your own run;
# no path hardcoding in the task itself.
#
# Paths below are examples matching the `products/` layout used by env.kec.yaml,
# env.assays.yaml and env.assays_consensus.yaml in this repo — adjust if you used a
# different products directory.

manuscript_repo: "/path/to/your/manuscript-repo"

# ── KEC116 (endorsed-pilot, ground truth available) ────────────────────────────
kec116_crossmodel_dir: "products/kec116/crossmodel/manuscript"

kec116_smaa_variants: ["default", "iri_valid", "no_logprob"]

# Related-checkpoint pairs whose triple-set Jaccard is reported against the whole panel's
# pairwise distribution. [] to skip. `relation` is free text and appears in the exported
# table; a pair need not be a requantization of one base, and the more distant relations
# are the informative ones - a pruned-and-distilled derivative measures how far heavier
# compression changes which triples a model proposes.
kec116_lineage_pairs:
  - {a: "<base_model_key>", b: "<quantized_model_key>", relation: "quantization"}
  - {a: "<base_model_key>", b: "<distilled_derivative_key>", relation: "pruned + distilled derivative"}

kec116_figures:
  - {src: "figures/fig_match_rate.png",         out: "fig_match_rate.png"}
  - {src: "figures/fig_logprob_roc.png",        out: "fig_logprob_roc.png"}
  - {src: "figures/fig_audit_verdicts.png",     out: "fig_audit_verdicts.png"}
  - {src: "figures/fig_pairwise_agreement.png", out: "fig_pairwise_agreement.png"}
  - {src: "figures/fig_consensus_support.png",  out: "fig_consensus_support.png"}
  - {src: "figures/fig_scatter_matrix.png",     out: "fig_scatter_matrix.png"}
  - {src: "default/figures/fig_smaa_rank.png",       out: "fig_smaa_rank_default.png"}
  - {src: "default/figures/fig_smaa_parallel.png",   out: "fig_smaa_parallel_default.png"}
  - {src: "iri_valid/figures/fig_smaa_rank.png",     out: "fig_smaa_rank_iri_valid.png"}
  - {src: "no_logprob/figures/fig_smaa_rank.png",    out: "fig_smaa_rank_no_logprob.png"}
  - {src: "default/greedy/figures/fig_ensemble_coverage.png", out: "fig_ensemble_coverage.png"}
  - {src: "default/pareto_smaa/figures/fig_ensemble_coverage.png", out: "fig_pareto_frontier.png"}
  - {src: "default/pareto_topsis/figures/fig_ensemble_coverage.png", out: "fig_pareto_frontier_topsis.png"}
  - {src: "../../<model_key>/fig_auc_explainer.png",
     out: "fig_auc_explainer_<model_key>.png"}

# ── KEC_ALL (full AOP-Wiki corpus, selected panel) ─────────────────────────────
kec_all_crossmodel_dir: "products/kec_all/crossmodel/manuscript"
kec_all_products_dir: "products/kec_all"
# Same panel as aop451_models below — kept in sync manually; update both if the
# selected panel ever changes.
kec_all_models:
  - "<model_key_1>"
  - "<model_key_2>"

kec_all_smaa_variants: ["default", "iri_valid", "no_logprob"]

kec_all_figures:
  - {src: "figures/fig_match_rate.png",         out: "fig_match_rate.png"}
  - {src: "figures/fig_logprob_roc.png",        out: "fig_logprob_roc.png"}
  - {src: "figures/fig_audit_verdicts.png",     out: "fig_audit_verdicts.png"}
  - {src: "figures/fig_pairwise_agreement.png", out: "fig_pairwise_agreement.png"}
  - {src: "figures/fig_consensus_support.png",  out: "fig_consensus_support.png"}
  - {src: "figures/fig_scatter_matrix.png",     out: "fig_scatter_matrix.png"}
  - {src: "default/figures/fig_smaa_rank.png",       out: "fig_smaa_rank_default.png"}
  - {src: "default/figures/fig_smaa_parallel.png",   out: "fig_smaa_parallel_default.png"}
  - {src: "iri_valid/figures/fig_smaa_rank.png",     out: "fig_smaa_rank_iri_valid.png"}
  - {src: "no_logprob/figures/fig_smaa_rank.png",    out: "fig_smaa_rank_no_logprob.png"}
  - {src: "default/greedy/figures/fig_ensemble_coverage.png", out: "fig_ensemble_coverage.png"}
  - {src: "default/pareto_smaa/figures/fig_ensemble_coverage.png", out: "fig_pareto_frontier.png"}
  - {src: "figures/fig_onto_recovery_process.png", out: "fig_onto_recovery_process.png"}
  - {src: "figures/fig_onto_recovery_object.png",  out: "fig_onto_recovery_object.png"}

# ── Assays (Methods2AOP, no ground truth) ───────────────────────────────────────
assays_crossmodel_dir: "products/assays/crossmodel/manuscript"

assays_smaa_variants: ["default"]

# Distinct-assay-technique count after name consolidation — produced by the Solr
# publish stage (assay_consensus2solr), which is NOT part of this repo's scope.
# Leave blank/omit if you have not run that stage; export_assays will skip this stat.
assay_technique_stats_json: ""

assays_figures:
  - {src: "figures/fig_assay_landscape.png",         out: "fig_assay_landscape.png"}
  - {src: "figures/fig_assay_consensus_support.png", out: "fig_assay_consensus_support.png"}
  - {src: "figures/fig_assay_pairwise.png",          out: "fig_assay_pairwise.png"}
  - {src: "default/figures/fig_smaa_rank.png",       out: "fig_smaa_rank_default.png"}

# ── Case study: AOP 451 (Nymark et al., PMID 35295099) ─────────────────────────
aop451_kec_products_dir: "products/kec_all"
aop451_assays_products_dir: "products/assays/assays"

# crossmodel_track_consistency's output for the same panel/release as the case
# study (see track_consistency.kec_products in env.assays_consensus.yaml). Adds
# per-assay cross-track match detail; blank/missing just omits it.
aop451_track_consistency_json: "products/assays/crossmodel/manuscript/crossmodel_track_consistency.json"

# Models to score in aop451_reference_check.
aop451_reference_check_models:
  - "<model_key_1>"
  - "<model_key_2>"

# Consensus threshold for the pooled-panel KEC recovery table; same value as
# env.consensus.yaml's min_support.
consensus_min_support: 2

# Kept in sync with resources/aop451_reference.json's key_events[].ke_ids.
aop451_kes:
  - "KE1495"  # MIE: interaction with lung resident cell membrane components
  - "KE1492"  # KE1A: Tissue resident cell activation
  - "KE1496"  # KE1A: Increased, secretion of proinflammatory mediators
  - "KE1497"  # KE1A: Increased, recruitment of inflammatory cells
  - "KE2006"  # KE1B: Secondary genotoxicity
  - "KE1115"  # KE1C: Increase, Reactive oxygen species
  - "KE1538"  # KE1C: Decreased protection against oxidative stress
  - "KE1088"  # KE1C: (third KE1C member per Figure 1A)
  - "KE1634"  # KE2: Increase, Oxidative DNA damage
  - "KE185"   # KE3: Increase, Mutations
  - "KE1869"  # KE3: Diminished protective oxidative stress response
  - "KE870"   # KE4: Increase, Cell Proliferation
  - "KE429"   # KE4: (second KE4 member per Figure 1A)
  - "KE1670"  # AO: Lung cancer

aop451_models:
  - "<model_key_1>"
  - "<model_key_2>"
